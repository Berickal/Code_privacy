# Copy to .env and fill in. Never commit .env. Keep REAL tokens out of this file.

# Phase A — corpus collection
GITHUB_TOKEN=github_pat_xxx           # fine-grained PAT, read-only public repos
SWH_TOKEN=                            # optional; raises SWH REST limit to 10 req/s

# The Stack v2 membership oracle (gated dataset)
HF_TOKEN=hf_xxx

# Phase F/G — hosted inference
OPENROUTER_API_KEY=sk-or-xxx
OPENROUTER_REFERER=https://your-institution.example.com

# Phase C/G — local fine-tuned checkpoints served by vLLM
VLLM_HOST=http://localhost:8000
VLLM_API_KEY=EMPTY

# Force the offline echo backend everywhere
EXPOSURE_GAP_OFFLINE=0

# Optional external tools
SOURCERERCC_JAR=
LOG_LEVEL=INFO
